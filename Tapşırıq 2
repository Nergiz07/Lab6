<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="UTF-8">
    <title>Buttonlar</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f0f2f5;
            padding: 40px;
        }

        .btn {
            padding: 10px 20px;
            border-radius: 8px;
            border: none;
            font-size: 16px;
            cursor: pointer;
            margin-right: 10px;
            transition: 0.3s;
        }

        
        .btn-primary {
            background-color: #3b82c4;
            color: white;
        }

        .btn-primary:hover {
            background-color: #2f6fa3;
        }

    
        .btn-outline {
            background-color: transparent;
            border: 2px solid #3b82c4;
            color: #3b82c4;
        }

        .btn-outline:hover {
            background-color: #3b82c4;
            color: white;
        }

  
        .btn-success {
            background-color: #22c55e;
            color: white;
        }

        .btn-success:hover {
            background-color: #1da34e;
        }

  
        .btn-danger {
            background-color: #e74c3c;
            color: white;
        }

        .btn-danger:hover {
            background-color: #c0392b;
        }
    </style>
</head>
<body>

    <button class="btn btn-primary">Normal</button>
    <button class="btn btn-outline">Outline</button>
    <button class="btn btn-success">Uğur</button>
    <button class="btn btn-danger">Təhlükə</button>

</body>
</html>
