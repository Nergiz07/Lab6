<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="UTF-8">
    <title>Cədvəl</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f5f5f5;
            padding: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background-color: white;
        }

        thead {
            background-color: #2f4050;
            color: white;
        }

        th, td {
            padding: 14px;
            text-align: left;
        }

        tr {
            border-bottom: 1px solid #ddd;
        }
        .badge {
            background-color: #2ecc71;
            color: white;
            padding: 5px 12px;
            border-radius: 15px;
            font-size: 12px;
        }
    </style>
</head>
<body>

<table>
    <thead>
        <tr>
            <th>Məhsul</th>
            <th>Qiymət</th>
            <th>Status</th>
        </tr>
    </thead>

    <tbody>
        <tr>
            <td>Laptop</td>
            <td>1200₼</td>
            <td><span class="badge">Mövcud</span></td>
        </tr>
    </tbody>
</table>

</body>
</html>
